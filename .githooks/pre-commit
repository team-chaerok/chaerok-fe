#!/bin/sh

set -e

# git이 훅을 실행할 때 주입하는 GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE이
# flutter 내부의 자체 git 버전 감지(SDK 저장소의 git describe)에 그대로
# 상속되어, flutter가 이 프로젝트 저장소를 SDK 저장소로 착각해
# "0.0.0-unknown" 버전으로 pub 의존성 해석에 실패하는 문제를 방지한다.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

echo "🔍 Checking staged Dart files..."

DART_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.dart$' || true)

if [ -n "$DART_FILES" ]; then
  echo "🎨 Running dart format..."
  dart format $DART_FILES

  echo "➕ Re-adding formatted Dart files..."
  git add $DART_FILES
else
  echo "No Dart files to format."
fi

echo "🧪 Running flutter analyze..."
flutter analyze

echo "✅ Pre-commit checks passed."